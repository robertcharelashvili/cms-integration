+    /**
+     * RILVEN (rilven-sync host patch): confirm a payroll run for Rilven. Only this run of its month
+     * stays confirmed, and it is remembered as it stands now (its fingerprint), so an edit made
+     * after this is not sent until confirmed again.
+     */
+    function rilven_confirm($did = NULL)
+    {
+        $this->sma->checkPermissions('salary', TRUE);
+        if (!$this->rilvenCanConfirmPayroll()) {
+            $this->sma->send_json(array('error' => 1, 'msg' => lang('access_denied')));
+        }
+        $did = (int) $did;
+        $run = $this->db->get_where('daricxva', array('id' => $did), 1)->row();
+        if (!$run) {
+            $this->sma->send_json(array('error' => 1, 'msg' => 'N' . $did . ' ვერ მოიძებნა'));
+        }
+        $this->load->library('rilven_payroll');
+        $fingerprint = $this->rilven_payroll->fingerprintOf($did);
+        if ($fingerprint === $did . ':0:0') {
+            $this->sma->send_json(array('error' => 1, 'msg' => 'N' . $did . ' ცარიელია -- დასადასტურებელი არაფერია'));
+        }
+        $table = $this->db->dbprefix('daricxva');
+        $this->db->query("UPDATE {$table} SET rilven_status = 0 WHERE id <> ? AND rilven_status = 1"
+            . " AND DATE_FORMAT(post_date, '%Y-%m') = DATE_FORMAT(?, '%Y-%m')", array($did, $run->post_date));
+        $this->db->update('daricxva', array(
+            'rilven_status' => 1,
+            'rilven_status_at' => date('Y-m-d H:i:s'),
+            'rilven_status_user' => $this->session->userdata('user_id'),
+            'rilven_fingerprint' => $fingerprint,
+        ), array('id' => $did));
+        $this->sma->send_json(array('error' => 0, 'msg' => 'N' . $did . ' დადასტურდა -- Rilven-ში გაიგზავნება'));
+    }
+
+    /**
+     * RILVEN: open a confirmed run again, to recalculate it. Nothing of the month is sent until a
+     * run is confirmed again; what Rilven already has stays as it is.
+     */
+    function rilven_reopen($did = NULL)
+    {
+        $this->sma->checkPermissions('salary', TRUE);
+        if (!$this->rilvenCanConfirmPayroll()) {
+            $this->sma->send_json(array('error' => 1, 'msg' => lang('access_denied')));
+        }
+        $did = (int) $did;
+        $this->db->update('daricxva', array(
+            'rilven_status' => 0,
+            'rilven_status_at' => date('Y-m-d H:i:s'),
+            'rilven_status_user' => $this->session->userdata('user_id'),
+        ), array('id' => $did));
+        $this->sma->send_json(array('error' => 0, 'msg' => 'N' . $did . ' გაიხსნა -- Rilven-ში აღარ იგზავნება, სანამ ხელახლა არ დადასტურდება'));
+    }
+
+    /** RILVEN: the owner, or a member of a group named in rilven_payroll_confirm_groups. */
+    private function rilvenCanConfirmPayroll()
+    {
+        if ($this->Owner) {
+            return TRUE;
+        }
+        $this->load->library('rilven_client');
+        foreach ((array) $this->rilven_client->cfg('rilven_payroll_confirm_groups', array()) as $group) {
+            if ($this->sma->in_group($group)) {
+                return TRUE;
+            }
+        }
+        return FALSE;
+    }
